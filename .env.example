# line-platform env (example)
APP_ENV=production
APP_NAME=line-platform

# Ports (avoid conflict with existing services)
UI_HOST=127.0.0.1
UI_PORT=3101
API_HOST=127.0.0.1
API_PORT=8101

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=line_platform
DB_USER=line_platform
DB_PASSWORD=CHANGE_ME

# Auth roles
ROLES=admin,staff,user
DEFAULT_LOCALE=ja-JP

# LINE channels (3 initial channels assumed)
LINE_CHANNEL_1_ID=
LINE_CHANNEL_1_SECRET=
LINE_CHANNEL_1_ACCESS_TOKEN=
LINE_CHANNEL_2_ID=
LINE_CHANNEL_2_SECRET=
LINE_CHANNEL_2_ACCESS_TOKEN=
LINE_CHANNEL_3_ID=
LINE_CHANNEL_3_SECRET=
LINE_CHANNEL_3_ACCESS_TOKEN=

# LINE Login (user auth)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK=https://line.sns-template.com/auth/line/callback

# Webhook public endpoint
WEBHOOK_BASE_URL=https://api.sns-template.com
